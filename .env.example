# SmartSense environment variables
# Copy this file to .env and fill in your real values.

# Recommended for production: deployed Supabase Edge Function URL.
EXPO_PUBLIC_AI_PROXY_URL=https://your-project-ref.functions.supabase.co/ai-advisor

# Local development fallback only. Do not ship a public client API key in production.
EXPO_PUBLIC_GEMINI_API_KEY=your_google_ai_studio_api_key

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional. Leave blank unless this exact URL is added to Supabase Auth redirect URLs.
EXPO_PUBLIC_AUTH_EMAIL_REDIRECT_URL=
